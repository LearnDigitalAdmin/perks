+
+export function repUI(){const g=view.rg||'7',cut=g=='all'?0:Date.now()-g*864e5,T=S.tx.filter(t=>t.status=='COMPLETED'&&new Date(t.at)>=cut),its=T.flatMap(t=>t.items),sm=(a)=>a.reduce((x,i)=>x+i.price,0),sv=sm(its.filter(i=>i.type=='SERVICE')),pr=sm(its.filter(i=>i.type=='PRODUCT')),earned=S.led.filter(l=>l.pts>0&&new Date(l.at)>=cut).reduce((a,l)=>a+l.pts,0),red=-S.led.filter(l=>l.type=='REDEEM'&&new Date(l.at)>=cut).reduce((a,l)=>a+l.pts,0),sm2=S.sms.filter(m=>new Date(m.at)>=cut),ok=sm2.filter(m=>m.st!='FAILED').length,newC=S.cs.filter(c=>new Date(c.created)>=cut).length,ret=S.cs.filter(c=>(c.txCount??S.tx.filter(t=>t.c==c.id).length)>1).length,camp={};sm2.forEach(m=>{const k=m.camp||'No campaign';camp[k]=(camp[k]||0)+1});const st=(b,s)=>`<div class="stat"><b>${b}</b><span>${s}</span></div>`;return`<h2>Reports</h2><select data-on-change="modules_reports_1">${[['1','Today'],['7','Last 7 days'],['30','Last 30 days'],['all','All time']].map(o=>`<option value="${o[0]}"${o[0]==g?' selected':''}>${o[1]}</option>`).join('')}</select><div class="grid">${st(money(sv+pr),'Sales ('+T.length+' tx)')}${st(money(sv),'Services')}${st(money(pr),'Products')}${st(earned,'Points earned')}${st(red,'Points redeemed')}${st(S.cs.reduce((a,c)=>a+bal(S,c.id),0),'Points liability')}${st(newC+' / '+ret,'New / returning')}${st(S.refs.filter(r=>r.st=='REWARDED').length+'/'+S.refs.length,'Referral conversion')}${st(S.vo.filter(v=>v.st=='REDEEMED').length+'/'+S.vo.length,'Vouchers used')}${st((sm2.length?Math.round(ok/sm2.length*100):0)+'%','SMS delivered · '+money(sm2.length*S.cfg.sms))}</div><div class="card" style="margin-top:12px"><h3>Campaign performance (SMS)</h3>${Object.entries(camp).map(e=>`<div class="li"><span>${e[0]}</span><b>${e[1]}</b></div>`).join('')}</div><button class="big" data-on-click="modules_reports_2" ${ap([cut],'click')}>Copy CSV</button>`}
