+if(!S.tpl)S.tpl={...TPL,voucher:'Samuhia Perks: You won voucher {code} worth {val}. Show it at Samuhia Cyber.',welcome:'Welcome to Samuhia Perks! Your referral code is {code}. Earn points on every visit.'};
